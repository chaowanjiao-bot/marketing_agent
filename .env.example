AGENT_TOOLSET=production
HOST=0.0.0.0
PORT=8000
MODEL_DEVICE=cuda:0
PYTHON_BIN=runtime/venv/gpu/bin/python

MARKETING_AGENT_ROOT=.
TASK_ROOT=runtime/tasks
MODEL_OUTPUT_DIR=runtime/outputs

QWEN_IMAGE_MODEL_PATH=runtime/models/Qwen-Image
POWERPAINT_MODEL_PATH=runtime/models/PowerPaint-v2
GROUNDING_DINO_MODEL_PATH=runtime/models/grounding-dino-base
SAM2_CHECKPOINT_PATH=runtime/models/sam2/sam2.1_hiera_large.pt

POWERPAINT_PYTHON=runtime/venv/powerpaint/bin/python
VQASCORE_PYTHON=runtime/venv/vqascore/bin/python
OCR_PYTHON=runtime/venv/vqascore/bin/python
MODEL_WORKER_TIMEOUT_SECONDS=900
MODEL_WORKER_MODE=persistent
GPU_MAX_CONCURRENT=1

# Disabled by default; no experience file is created until explicitly enabled and learned.
EXPERIENCE_MEMORY_ENABLED=false
EXPERIENCE_MEMORY_PATH=runtime/memory/experience.jsonl

# Content Credentials are disabled unless explicitly configured.
C2PA_ENABLED=false
C2PA_MANIFEST_ONLY=false
C2PATOOL_PATH=/usr/local/bin/c2patool
C2PA_SIGN_CERT_PATH=privatecredentials/c2pa_sign_cert.pem
C2PA_PRIVATE_KEY_PATH=privatecredentials/c2pa_private_key.pem
C2PA_SIGNING_ALGORITHM=es256
C2PA_TIMEOUT_SECONDS=120
