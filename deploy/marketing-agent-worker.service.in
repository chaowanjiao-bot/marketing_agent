[Unit]
Description=Marketing Creative Agent GPU Worker
After=network.target marketing-agent-api.service
[Service]
Type=simple
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__ENV_FILE__
ExecStart=__PROJECT_DIR__/deploy/manage.sh run-worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
[Install]
WantedBy=multi-user.target
