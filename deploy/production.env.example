# Copy to deploy/production.env. Never commit the real file.
AGENT_TOOLSET=production
TASK_EXECUTION_MODE=external
AUTH_ENABLED=true
AUTH_SECURE_COOKIE=false
MARKETING_AGENT_ROOT=/picassox/cephfs/beauty/intern_beauty/jcw1/marketing-creative-agent
TASK_ROOT=/picassox/cephfs/beauty/intern_beauty/jcw1/marketing-creative-agent/runtime/production/tasks
TASK_DATABASE_PATH=/picassox/cephfs/beauty/intern_beauty/jcw1/marketing-creative-agent/runtime/production/task_metadata.sqlite3
TASK_QUEUE_PATH=/picassox/cephfs/beauty/intern_beauty/jcw1/marketing-creative-agent/runtime/production/task_queue.sqlite3
AUTH_DATABASE_PATH=/picassox/cephfs/beauty/intern_beauty/jcw1/marketing-creative-agent/runtime/production/accounts.sqlite3
MODEL_OUTPUT_DIR=/picassox/cephfs/beauty/intern_beauty/jcw1/marketing-creative-agent/runtime/production/outputs
API_HOST=127.0.0.1
API_PORT=8000
CUDA_VISIBLE_DEVICES=0
GPU_MAX_CONCURRENT=1
QWEN_UNLOAD_AFTER_GENERATE=true
# A single 80GB GPU cannot keep VQAScore and OCR resident together safely.
# oneshot releases each evaluator before the next GPU stage starts.
MODEL_WORKER_MODE=oneshot
MODEL_WORKER_TIMEOUT=900
WORKER_STALE_SECONDS=3600
WORKER_POLL_SECONDS=1
RAG_ENABLED=false
EXPERIENCE_MEMORY_ENABLED=false
C2PA_ENABLED=false
C2PA_MANIFEST_ONLY=false
POWERPAINT_PYTHON=/picassox/cephfs/beauty/intern_beauty/jcw1/marketing-creative-agent/runtime/venv/powerpaint/bin/python
VQASCORE_PYTHON=/picassox/cephfs/beauty/intern_beauty/jcw1/marketing-creative-agent/runtime/venv/vqascore/bin/python
OCR_PYTHON=/picassox/cephfs/beauty/intern_beauty/jcw1/marketing-creative-agent/runtime/venv/vqascore/bin/python
APP_PYTHON=/picassox/cephfs/beauty/intern_beauty/jcw1/marketing-creative-agent/runtime/venv/gpu/bin/python
# Required by deterministic Chinese typography compositing.
TYPOGRAPHY_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# Optional structured Brief/Strategy model. Configure all three or leave all empty.
STRUCTURED_MODEL_BASE_URL=
STRUCTURED_MODEL_NAME=
STRUCTURED_MODEL_API_KEY=
# Bounded node retries and recoverable state boundaries.
MULTI_AGENT_MAX_NODE_ATTEMPTS=2
MULTI_AGENT_CHECKPOINTS=true
MULTI_AGENT_CHECKPOINT_DIR=/picassox/cephfs/beauty/intern_beauty/jcw1/marketing-creative-agent/runtime/production/checkpoints
